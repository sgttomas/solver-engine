# =============================================================================
# SOLVER API Configuration - Doc 3 §12
# =============================================================================
# Copy this file to .env and fill in values

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# PostgreSQL (Doc 3 §7)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=solver
POSTGRES_PASSWORD=solver
POSTGRES_DB=solver

# LLM Provider (at least one required)
DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Workflow (Doc 2 §2.2)
DEFAULT_GATE_POLICY=per_step

# API
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# Observability (optional)
# OBSERVABILITY_PROVIDER=langsmith
# LANGSMITH_API_KEY=